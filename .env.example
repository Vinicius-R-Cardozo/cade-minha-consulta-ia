# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git (está no .gitignore).

# Chave da API da Anthropic (Claude). Sem ela, o serviço funciona com mensagens de modelo fixo (template).
ANTHROPIC_API_KEY=

# Modelo e esforço de raciocínio da IA generativa
VAGACERTA_LLM_MODELO=claude-opus-5-5
VAGACERTA_LLM_ESFORCO=low
# 1 = se o modelo recusar a solicitação, a API tenta um modelo de reserva (fallback no servidor)
VAGACERTA_LLM_FALLBACK_SERVIDOR=1
VAGACERTA_LLM_TIMEOUT_S=30

# Token que o backend Java envia no cabeçalho X-Service-Token. Vazio = sem exigência (só em desenvolvimento).
VAGACERTA_TOKEN_SERVICO=
