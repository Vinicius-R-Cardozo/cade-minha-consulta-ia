# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git (está no .gitignore).
# O mesmo .env é lido pelo Python (serviço de IA) e pelo script que sobe o n8n (scripts/n8n_iniciar.ps1).

# ---------- n8n + Google Gemini (IA generativa) ----------
# Chave gratuita em https://aistudio.google.com/apikey. Fica só no n8n; o Python nunca a vê.
GEMINI_API_KEY=
# Modelo do Gemini (fixo para a avaliação ser reproduzível; "gemini-flash-latest" acompanha o Flash mais novo).
GEMINI_MODELO=gemini-3.8-flash
# Reserva: o n8n usa quando o principal responde 429/503 ou demora mais de 20 s.
GEMINI_MODELO_RESERVA=gemini-3.5-flash-lite

# Token que o Python envia ao webhook do n8n (cabeçalho X-Cade-Token). Invente uma sequência longa.
CADE_N8N_TOKEN=

# ---------- Serviço Python ----------
# "n8n" liga a IA generativa; "desligada" usa só o template (mensagem de modelo fixo).
CADE_IA=n8n
CADE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/cade-minha-consulta-mensagem
CADE_N8N_TIMEOUT_S=50

# Token que o backend Java envia no cabeçalho X-Service-Token. Vazio = sem exigência (só em desenvolvimento).
CADE_TOKEN_SERVICO=
