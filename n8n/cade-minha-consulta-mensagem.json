    {
      "parameters": {
        "jsCode": "// Converte a resposta do Gemini no contrato que o Python espera.\n// Sucesso: { ok: true, modelo, via_reserva, resultado, uso }  |  Falha: { ok: false, erro }\nconst r = $input.first().json;\nlet viaReserva = false;\ntry { viaReserva = $('Gemini modelo reserva').isExecuted; } catch (e) { viaReserva = false; }\n\nif (r.error && r.statusCode === undefined) {\n  const msg = (r.error.message || JSON.stringify(r.error)).slice(0, 200);\n  return [{ json: { ok: false, erro: 'Falha de rede ou tempo esgotado no Gemini: ' + msg } }];\n}\nconst status = r.statusCode;\nconst body = (typeof r.body === 'string') ? (() => { try { return JSON.parse(r.body); } catch (e) { return {}; } })() : (r.body || {});\n\nif (status !== 200) {\n  const msg = (body.error && body.error.message) || ('HTTP ' + status);\n  return [{ json: { ok: false, erro: 'Gemini HTTP ' + status + ': ' + String(msg).slice(0, 200) } }];\n}\nconst cand = (body.candidates || [])[0];\nif (!cand) {\n  const motivo = (body.promptFeedback && body.promptFeedback.blockReason) || 'sem resposta';\n  return [{ json: { ok: false, erro: 'Gemini bloqueou o pedido: ' + motivo } }];\n}\nif (cand.finishReason && cand.finishReason !== 'STOP') {\n  return [{ json: { ok: false, erro: 'Gemini terminou com ' + cand.finishReason } }];\n}\nconst texto = ((cand.content && cand.content.parts) || [])\n  .filter(p => !p.thought)\n  .map(p => p.text || '')\n  .join('');\nlet resultado;\ntry {\n  resultado = JSON.parse(texto);\n} catch (e) {\n  return [{ json: { ok: false, erro: 'Gemini devolveu JSON inválido' } }];\n}\nreturn [{ json: { ok: true, modelo: body.modelVersion || null, via_reserva: viaReserva, resultado, uso: body.usageMetadata || null } }];\n"
      },
